# ============================================
# 「朋友说」systemd 服务配置
# 用法：
#   sudo cp deploy/friendwall.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now friendwall
# ============================================

[Unit]
Description=Friend Wall - personal testimonial wall
After=network.target

[Service]
Type=simple
# ⚠️ 改成你的实际部署用户和路径
User=root
WorkingDirectory=/opt/friend-wall
ExecStart=/usr/bin/node server.js
Environment=PORT=3000
Environment=ADMIN_PASSWORD=admin123
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
